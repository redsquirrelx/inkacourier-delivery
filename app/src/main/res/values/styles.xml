<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Componentes -->
    <style name="FormaRedondeada" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/borde</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Boton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="BotonTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BotonContorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/contorno</item>
    </style>

    <style name="BotonPeligro" parent="BotonContorno">
        <item name="android:textColor">@color/estado_visita_fallida</item>
        <item name="iconTint">@color/estado_visita_fallida</item>
        <item name="strokeColor">@color/estado_visita_fallida</item>
    </style>

    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/FormaRedondeada</item>
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxStrokeColor">@color/primario</item>
        <item name="startIconTint">@color/texto_secundario</item>
    </style>

    <style name="NavegacionInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/superficie</item>
        <item name="itemActiveIndicatorStyle">@style/IndicadorNavegacion</item>
        <item name="itemIconTint">@color/selector_navegacion</item>
        <item name="itemTextColor">@color/selector_navegacion</item>
    </style>

    <style name="IndicadorNavegacion" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primario_claro</item>
    </style>

    <style name="TemaDialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/FormaDialogo</item>
    </style>

    <style name="FormaDialogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="BarraHerramientas" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/primario</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- Textos -->
    <style name="TextoSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">@color/primario_oscuro</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableTint">@color/primario</item>
    </style>

    <style name="TituloBloque">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoValor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <!-- Fila con ícono a la izquierda (dirección, teléfono, horario...). -->
    <style name="FilaIcono" parent="TextoValor">
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="drawableTint">@color/texto_secundario</item>
    </style>

    <style name="TextoSecundario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="InsigniaEstado">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fondo_insignia</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoVacio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="ContenidoTarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="TarjetaSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
