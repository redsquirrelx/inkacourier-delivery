<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Franja de color según el estado operativo -->
        <View
            android:id="@+id/franjaEstado"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/estado_en_ruta" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="14dp">

            <TextView
                android:id="@+id/textoEncabezado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/texto_secundario"
                app:layout_constraintBottom_toBottomOf="@id/textoEstado"
                app:layout_constraintEnd_toStartOf="@id/textoEstado"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textoEstado"
                tools:text="Parada 1 · INK-24011" />

            <TextView
                android:id="@+id/textoEstado"
                style="@style/InsigniaEstado"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="En ruta" />

            <TextView
                android:id="@+id/textoDestinatario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textoEstado"
                tools:text="María Fernández Rojas" />

            <TextView
                android:id="@+id/textoDireccion"
                style="@style/FilaIcono"
                android:layout_width="0dp"
                android:layout_marginTop="6dp"
                app:drawableStartCompat="@drawable/ic_ubicacion"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textoDestinatario"
                tools:text="Av. Arequipa 1450 - Lince" />

            <TextView
                android:id="@+id/textoComplemento"
                style="@style/FilaIcono"
                android:layout_width="0dp"
                android:layout_marginTop="4dp"
                app:drawableStartCompat="@drawable/ic_reloj"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textoDireccion"
                tools:text="09:00 - 13:00 · S/ 159.90 · Prepagado" />

            <TextView
                android:id="@+id/textoCambioOficina"
                style="@style/InsigniaEstado"
                android:layout_marginTop="8dp"
                android:backgroundTint="#26D39B2A"
                app:drawableStartCompat="@drawable/ic_informacion"
                android:text="@string/actualizado_por_oficina"
                android:textColor="#FF9A6B0C"
                android:visibility="gone"
                app:drawableTint="#FF9A6B0C"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textoComplemento"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
