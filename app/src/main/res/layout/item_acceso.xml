<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de acceso reutilizable: ícono, título, descripción y flecha. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imagenIcono"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/fondo_icono_circular"
            android:importantForAccessibility="no"
            android:padding="10dp"
            app:tint="@color/primario"
            tools:src="@drawable/ic_lista" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textStyle="bold"
                tools:text="Mis paradas" />

            <TextView
                android:id="@+id/textoDetalle"
                style="@style/TextoSecundario"
                tools:text="Todas las paradas asignadas" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flecha_derecha"
            app:tint="@color/texto_secundario" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
